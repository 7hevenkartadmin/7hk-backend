NODE_ENV=development
PORT=5000
API_VERSION=v1
MONGODB_URI=mongodb://localhost:27017/7heaven
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://admin.localhost:5173
COOKIE_SECURE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REDIS_URL=redis://127.0.0.1:6379
OTP_QUEUE_NAME=otp-notifications
OTP_WORKER_ENABLED=true
WHATSAPP_PROVIDER=mock
LOW_STOCK_THRESHOLD=20
STORE_LATITUDE=26.713052497465416
STORE_LONGITUDE=85.68640273918543
DELIVERY_RADIUS_KM=10

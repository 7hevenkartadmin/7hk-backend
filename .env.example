NODE_ENV=development
PORT=5000
API_VERSION=v1
MONGODB_URI=mongodb://localhost:27017/7heaven
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-refresh
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://admin.localhost:5173
COOKIE_SECURE=false
ADMIN_APP_URL=http://localhost:5174
# 32 random bytes encoded as 64 hex characters. Required in production.
OWNER_TOTP_ENCRYPTION_KEY=
# Required in production for admin invitations, reset links, and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=security@7hevenkart.com
# Backend only. Production startup requires a Live Mode key beginning with rzp_live_.
# Keep the API secret and the separate webhook secret out of every web/Android bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_URL=redis://127.0.0.1:6379
OTP_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
OTP_QUEUE_NAME=otp-notifications
OTP_WORKER_ENABLED=true
# Local development: console. Production: meta. Use disabled to turn delivery off.
WHATSAPP_PROVIDER=console
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=sevenheaven_login_otp
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_GRAPH_API_VERSION=v23.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PUBLIC_CALLBACK_URL=
WHATSAPP_SMOKE_TEST_ALLOWLISTED_PHONE=
WHATSAPP_CALLBACK_ENVIRONMENT=
WHATSAPP_CALLBACK_DEPLOYMENT_ID=
WHATSAPP_CALLBACK_READINESS_RUN_ID=
WHATSAPP_CALLBACK_EVIDENCE_PRODUCER_ID=
WHATSAPP_CALLBACK_EVIDENCE_PUBLIC_KEY=
WHATSAPP_CALLBACK_EVIDENCE_REPLAY_DIRECTORY=.whatsapp-callback-readiness-runs
REQUIRE_INTEGRATION_FIXTURES=false


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=7heven/catalog
CLOUDINARY_MAX_IMAGE_MB=3
LOW_STOCK_THRESHOLD=20
STORE_LATITUDE=26.713052497465416
STORE_LONGITUDE=85.68640273918543
DELIVERY_RADIUS_KM=10
# Android requests send X-Client-Platform: android and X-Firebase-AppCheck.
# Use monitor during rollout, then enforce in production. The backend service
# account must have the Firebase App Check Token Verifier role.
ANDROID_APP_CHECK_MODE=monitor
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=

{
  "name": "7heaven-backend",
  "version": "1.0.0",
  "description": "Industry-grade modular monolith API for the 7Heven grocery platform.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:backend": "node --test tests/*.test.js",
    "test:api": "node --test tests/api.integration.test.js",
    "test:services": "node --test tests/*service.test.js",
    "test:schemas": "node --test tests/model-schema.test.js tests/validation.test.js",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nanoid": "^5.0.7",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.4",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
